{"format":1,"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no\">\n<title>Mancala</title>\n<style>\n  :root {\n    --primary: #8B5A2B; --secondary: #2A7F62; --accent: #E9B949;\n    --page: #F6EBD9; --text: #2A1D10;\n    --pit: rgba(0,0,0,.26); --stone: #F3E7D3; --stone-edge: #B9A58B;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root { --page: #2A1D10; --text: #F6EBD9; --pit: rgba(0,0,0,.38); }\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n  html, body { height: 100%; overflow: hidden; }\n  body {\n    background: var(--page); color: var(--text);\n    font-family: -apple-system, \"SF Pro Rounded\", system-ui, sans-serif;\n    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n    touch-action: manipulation;\n  }\n  #app {\n    position: fixed; inset: 0;\n    padding: calc(env(safe-area-inset-top) + 6px) 12px calc(env(safe-area-inset-bottom) + 8px);\n    display: flex; flex-direction: column; gap: 8px;\n  }\n  .status {\n    flex: 0 0 auto; text-align: center; font-size: 15px; font-weight: 600;\n    letter-spacing: .2px; opacity: .85; min-height: 20px; transition: opacity .2s;\n  }\n  .status.mine { opacity: 1; }\n  .board {\n    flex: 1 1 auto; min-height: 0;\n    background: linear-gradient(160deg, rgba(255,255,255,.14), rgba(0,0,0,.18)), var(--primary);\n    border-radius: 28px; padding: 10px;\n    box-shadow: 0 10px 30px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.18);\n    display: grid; grid-template-rows: 64px 1fr 64px; gap: 8px;\n  }\n  .store {\n    border-radius: 20px; background: var(--pit);\n    box-shadow: inset 0 3px 8px rgba(0,0,0,.35);\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 0 16px; position: relative; overflow: hidden;\n  }\n  .store .name { font-size: 15px; font-weight: 700; color: #fff; opacity: .9; max-width: 50%;\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .store .count { font-size: 30px; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums;\n    transition: transform .25s; }\n  .store.bump .count { animation: bump .45s ease-out; }\n  .store::before { content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--owner); }\n  .field { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; min-height: 0; }\n  .col { display: grid; grid-template-rows: repeat(6, 1fr); gap: 8px; min-height: 0; }\n  .pit {\n    position: relative; border-radius: 18px; background: var(--pit);\n    box-shadow: inset 0 3px 8px rgba(0,0,0,.35);\n    transition: transform .15s, box-shadow .2s, opacity .2s; overflow: visible;\n  }\n  .pit .n {\n    position: absolute; right: 7px; top: 6px; min-width: 22px; height: 22px; padding: 0 6px;\n    border-radius: 11px; background: rgba(0,0,0,.35); color: #fff; font-size: 13px; font-weight: 700;\n    display: flex; align-items: center; justify-content: center; font-variant-numeric: tabular-nums;\n  }\n  .pit .n.zero { opacity: .35; }\n  .pit.legal { box-shadow: inset 0 3px 8px rgba(0,0,0,.35), 0 0 0 3px var(--accent); cursor: pointer; }\n  .pit.legal:active { transform: scale(.96); }\n  .pit.dim { opacity: .55; }\n  .pit.sow { animation: sow .5s ease-out both; }\n  .pit.cap { animation: cap .7s ease-out both; }\n  .stone {\n    position: absolute; width: var(--d); height: var(--d); border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #fff, var(--stone) 55%, var(--stone-edge));\n    box-shadow: 0 1px 2px rgba(0,0,0,.4); transform: translate(-50%, -50%);\n  }\n  .stone.pop { animation: pop .35s ease-out both; }\n  @keyframes pop { from { transform: translate(-50%, -50%) scale(0); } 70% { transform: translate(-50%, -50%) scale(1.25); } to { transform: translate(-50%, -50%) scale(1); } }\n  @keyframes sow { 0% { box-shadow: inset 0 3px 8px rgba(0,0,0,.35), 0 0 0 0 rgba(255,255,255,.9); } 100% { box-shadow: inset 0 3px 8px rgba(0,0,0,.35), 0 0 0 10px rgba(255,255,255,0); } }\n  @keyframes cap { 0%, 100% { background: var(--pit); } 40% { background: var(--accent); } }\n  @keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.3); } 100% { transform: scale(1); } }\n  .hint { flex: 0 0 auto; text-align: center; font-size: 13px; opacity: .6; min-height: 16px; }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"status\" id=\"status\"></div>\n  <div class=\"board\">\n    <div class=\"store\" id=\"storeTop\"><span class=\"name\"></span><span class=\"count\">0</span></div>\n    <div class=\"field\">\n      <div class=\"col\" id=\"colLeft\"></div>\n      <div class=\"col\" id=\"colRight\"></div>\n    </div>\n    <div class=\"store\" id=\"storeBottom\"><span class=\"name\"></span><span class=\"count\">0</span></div>\n  </div>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n(function () {\n  var T = {\n    en: { yourTurn: \"Your turn\", turnOf: \"{name}'s turn\", again: \"Move again!\", over: \"Game over\", tap: \"Tap a pit to sow its stones\", waiting: \"Sending…\" },\n    hy: { yourTurn: \"Քո հերթն է\", turnOf: \"{name}-ի հերթն է\", again: \"Խաղա նորից\", over: \"Խաղն ավարտվեց\", tap: \"Սեղմիր փոսիկը՝ քարերը ցանելու համար\", waiting: \"Ուղարկվում է…\" },\n    ru: { yourTurn: \"Твой ход\", turnOf: \"Ход {name}\", again: \"Ходи снова!\", over: \"Игра окончена\", tap: \"Нажми лунку, чтобы разложить камни\", waiting: \"Отправка…\" },\n    es: { yourTurn: \"Tu turno\", turnOf: \"Turno de {name}\", again: \"¡Mueve otra vez!\", over: \"Fin de la partida\", tap: \"Toca un hoyo para sembrar\", waiting: \"Enviando…\" },\n    de: { yourTurn: \"Du bist dran\", turnOf: \"{name} ist dran\", again: \"Noch einmal!\", over: \"Spiel vorbei\", tap: \"Tippe eine Mulde an\", waiting: \"Senden…\" },\n    fr: { yourTurn: \"À toi\", turnOf: \"Au tour de {name}\", again: \"Rejoue !\", over: \"Partie terminée\", tap: \"Touche un trou pour semer\", waiting: \"Envoi…\" },\n    ar: { yourTurn: \"دورك\", turnOf: \"دور {name}\", again: \"العب مجددًا!\", over: \"انتهت اللعبة\", tap: \"اضغط حفرة لتوزيع الحصى\", waiting: \"جارٍ الإرسال…\" }\n  };\n  function t(lang, key, name) {\n    var d = T[lang] || T.en;\n    var s = d[key] || T.en[key] || key;\n    return s.replace(\"{name}\", name || \"\");\n  }\n\n  var el = function (id) { return document.getElementById(id); };\n  var pitEls = {};          // absolute index -> element\n  var prevPits = null;\n  var pending = false, pendingTimer = null;\n  var current = null;      // {state, ctx}\n\n  function buildBoard(seat) {\n    var left = el(\"colLeft\"), right = el(\"colRight\");\n    left.innerHTML = \"\"; right.innerHTML = \"\";\n    pitEls = {};\n    var opp = 1 - seat;\n    for (var k = 0; k < 6; k++) {\n      var mine = makePit(seat * 7 + k);\n      left.appendChild(mine);\n      var theirs = makePit(opp * 7 + (5 - k));\n      right.appendChild(theirs);\n    }\n  }\n  function makePit(index) {\n    var d = document.createElement(\"div\");\n    d.className = \"pit\";\n    d.setAttribute(\"data-index\", index);\n    var n = document.createElement(\"div\");\n    n.className = \"n\";\n    d.appendChild(n);\n    d.addEventListener(\"click\", onTap);\n    pitEls[index] = d;\n    return d;\n  }\n\n  // Deterministic stone positions: centre, then rings of 6, 12 and 18.\n  var RINGS = [[0, 1], [6, 0.34], [12, 0.62], [18, 0.86]];\n  function stonePositions(count) {\n    var out = [], k = 0;\n    if (count > 0) { out.push([0.5, 0.5]); k = 1; }\n    for (var r = 1; r < RINGS.length && k < count; r++) {\n      var n = RINGS[r][0], radius = RINGS[r][1];\n      for (var i = 0; i < n && k < count; i++, k++) {\n        var a = (i / n) * Math.PI * 2 + r * 0.4;\n        out.push([0.5 + Math.cos(a) * radius * 0.45, 0.5 + Math.sin(a) * radius * 0.42]);\n      }\n    }\n    return out;\n  }\n\n  function renderPit(index, count, oldCount, delayMs, captured) {\n    var d = pitEls[index];\n    if (!d) return;\n    var kept = d.querySelector(\".n\");\n    d.innerHTML = \"\";\n    var shown = Math.min(count, 37);\n    var pos = stonePositions(shown);\n    var dia = Math.max(10, Math.min(18, Math.floor(d.clientHeight * 0.22)));\n    for (var i = 0; i < shown; i++) {\n      var s = document.createElement(\"div\");\n      s.className = \"stone\" + (i >= oldCount ? \" pop\" : \"\");\n      s.style.setProperty(\"--d\", dia + \"px\");\n      s.style.left = (pos[i][0] * 100) + \"%\";\n      s.style.top = (pos[i][1] * 100) + \"%\";\n      if (i >= oldCount) s.style.animationDelay = delayMs + \"ms\";\n      d.appendChild(s);\n    }\n    kept.textContent = count;\n    kept.className = \"n\" + (count === 0 ? \" zero\" : \"\");\n    d.appendChild(kept);\n    d.classList.remove(\"sow\", \"cap\");\n    if (delayMs >= 0 && count !== oldCount) {\n      void d.offsetWidth;\n      d.style.animationDelay = delayMs + \"ms\";\n      d.classList.add(captured ? \"cap\" : \"sow\");\n    }\n  }\n\n  function renderStore(node, count, oldCount, name, color, delayMs) {\n    node.querySelector(\".name\").textContent = name;\n    node.querySelector(\".count\").textContent = count;\n    node.style.setProperty(\"--owner\", color);\n    node.classList.remove(\"bump\");\n    if (count > oldCount) {\n      void node.offsetWidth;\n      node.querySelector(\".count\").style.animationDelay = delayMs + \"ms\";\n      node.classList.add(\"bump\");\n    }\n  }\n\n  function render(state, ctx) {\n    var seat = ctx.seat, opp = 1 - seat;\n    var th = ctx.theme || {};\n    var root = document.documentElement.style;\n    if (th.primary) root.setProperty(\"--primary\", th.primary);\n    if (th.secondary) root.setProperty(\"--secondary\", th.secondary);\n    if (th.accent) root.setProperty(\"--accent\", th.accent);\n    if (th.page) root.setProperty(\"--page\", th.page);\n    if (th.text) root.setProperty(\"--text\", th.text);\n    var seatColor = [th.primary || \"#8B5A2B\", th.secondary || \"#2A7F62\"];\n    root.setProperty(\"--me\", seatColor[seat]);\n\n    if (!pitEls[seat * 7]) buildBoard(seat);\n    if (current && current.ctx.seat !== seat) buildBoard(seat);\n\n    var old = prevPits || state.pits;\n    var last = state.last;\n    var delayFor = {};\n    if (last && last.path) {\n      for (var i = 0; i < last.path.length; i++) delayFor[last.path[i]] = i * 70;\n    }\n    var captured = {};\n    if (last && last.capture) {\n      captured[last.capture.pit] = true;\n      captured[last.capture.opposite] = true;\n    }\n    for (var p = 0; p < 14; p++) {\n      if (p === 6 || p === 13) continue;\n      var delay = delayFor.hasOwnProperty(p) ? delayFor[p] : (captured[p] ? 500 : -1);\n      renderPit(p, state.pits[p], prevPits ? old[p] : state.pits[p], delay, !!captured[p]);\n    }\n    var lastDelay = last && last.path ? last.path.length * 70 : 0;\n    renderStore(el(\"storeBottom\"), state.pits[seat * 7 + 6], prevPits ? old[seat * 7 + 6] : 0,\n                ctx.names[seat] || \"\", seatColor[seat], Math.max(0, lastDelay - 70));\n    renderStore(el(\"storeTop\"), state.pits[opp * 7 + 6], prevPits ? old[opp * 7 + 6] : 0,\n                ctx.names[opp] || \"\", seatColor[opp], Math.max(0, lastDelay - 70));\n    prevPits = state.pits.slice();\n\n    var legal = {};\n    if (ctx.myTurn && !ctx.over && typeof game !== \"undefined\") {\n      var moves = game.autoplay(state, seat);\n      for (var m = 0; m < moves.length; m++) legal[seat * 7 + moves[m].pit] = true;\n    }\n    for (var q = 0; q < 14; q++) {\n      var node = pitEls[q];\n      if (!node) continue;\n      var isLegal = !!legal[q] && !pending;\n      node.classList.toggle(\"legal\", isLegal);\n      node.classList.toggle(\"dim\", !ctx.over && !ctx.myTurn && q >= seat * 7 && q < seat * 7 + 6);\n    }\n\n    var status = el(\"status\");\n    status.classList.toggle(\"mine\", !!ctx.myTurn && !ctx.over);\n    var hint = el(\"hint\");\n    if (ctx.over) {\n      status.textContent = t(ctx.lang, \"over\");\n      hint.textContent = \"\";\n    } else if (ctx.myTurn) {\n      var again = last && last.extra && last.seat === seat;\n      status.textContent = again ? t(ctx.lang, \"yourTurn\") + \" · \" + t(ctx.lang, \"again\") : t(ctx.lang, \"yourTurn\");\n      hint.textContent = pending ? t(ctx.lang, \"waiting\") : t(ctx.lang, \"tap\");\n    } else {\n      status.textContent = t(ctx.lang, \"turnOf\", ctx.names[state.turn] || \"\");\n      hint.textContent = \"\";\n    }\n  }\n\n  function onTap(e) {\n    if (!current || pending) return;\n    var node = e.currentTarget;\n    if (!node.classList.contains(\"legal\")) return;\n    var index = parseInt(node.getAttribute(\"data-index\"), 10);\n    var seat = current.ctx.seat;\n    if (index < seat * 7 || index > seat * 7 + 5) return;\n    pending = true;\n    clearTimeout(pendingTimer);\n    pendingTimer = setTimeout(function () { pending = false; if (current) render(current.state, current.ctx); }, 1500);\n    if (window.AirPlayne && AirPlayne.haptic) AirPlayne.haptic(\"tap\");\n    AirPlayne.send({ pit: index - seat * 7 });\n    render(current.state, current.ctx);\n  }\n\n  window.addEventListener(\"resize\", function () { if (current) { prevPits = null; render(current.state, current.ctx); } });\n\n  AirPlayne.onState(function (state, ctx) {\n    pending = false;\n    clearTimeout(pendingTimer);\n    var wasOver = !!(current && current.ctx.over);\n    current = { state: state, ctx: ctx };\n    render(state, ctx);\n    if (ctx.over && !wasOver && AirPlayne.haptic) AirPlayne.haptic(ctx.outcome && ctx.outcome.win === ctx.seat ? \"success\" : \"tap\");\n  });\n})();\n</script>\n</body>\n</html>\n","logic":"// Mancala (Kalah) rules for AirPlayne. Pure reducer: no DOM, no clock, no randomness.\n//\n// Board indices run counter-clockwise:\n//   0…5   seat 0's pits (bottom row, left to right)      6   seat 0's store\n//   7…12  seat 1's pits (top row, right to left)         13  seat 1's store\n// Pit i faces pit 12 - i. Move: {\"pit\": 0…5}, relative to the seat that plays it.\n\nconst game = {\n  init: function (opts) {\n    var pits = [];\n    for (var i = 0; i < 14; i++) pits.push(i === 6 || i === 13 ? 0 : 4);\n    var starter = opts && typeof opts.starter === \"number\" ? opts.starter : 0;\n    return {\n      pits: pits,\n      turn: starter === 1 ? 1 : 0,\n      over: false,\n      moves: 0,\n      last: null\n    };\n  },\n\n  apply: function (state, move, seat) {\n    if (state.over) throw new Error(\"Game over\");\n    if (seat !== state.turn) throw new Error(\"Not your turn\");\n    if (!move || typeof move.pit !== \"number\" || move.pit < 0 || move.pit > 5 || move.pit % 1 !== 0) {\n      throw new Error(\"Invalid move\");\n    }\n    var from = seat * 7 + move.pit;\n    var stones = state.pits[from];\n    if (stones === 0) throw new Error(\"That pit is empty\");\n\n    var pits = state.pits;\n    var ownStore = seat === 0 ? 6 : 13;\n    var skipStore = seat === 0 ? 13 : 6;\n    var path = [];\n    pits[from] = 0;\n    var i = from;\n    while (stones > 0) {\n      i = (i + 1) % 14;\n      if (i === skipStore) continue;\n      pits[i] += 1;\n      path.push(i);\n      stones -= 1;\n    }\n\n    var capture = null;\n    var extra = i === ownStore;\n    var ownSide = seat === 0 ? i >= 0 && i <= 5 : i >= 7 && i <= 12;\n    if (!extra && ownSide && pits[i] === 1) {\n      var opposite = 12 - i;\n      if (pits[opposite] > 0) {\n        var taken = pits[opposite] + 1;\n        pits[opposite] = 0;\n        pits[i] = 0;\n        pits[ownStore] += taken;\n        capture = { pit: i, opposite: opposite, stones: taken };\n      }\n    }\n\n    state.last = { seat: seat, from: from, path: path, capture: capture, extra: extra };\n    state.moves += 1;\n\n    var side0 = 0, side1 = 0;\n    for (var p = 0; p < 6; p++) side0 += pits[p];\n    for (var q = 7; q < 13; q++) side1 += pits[q];\n    if (side0 === 0 || side1 === 0) {\n      for (var a = 0; a < 6; a++) { pits[6] += pits[a]; pits[a] = 0; }\n      for (var b = 7; b < 13; b++) { pits[13] += pits[b]; pits[b] = 0; }\n      state.over = true;\n      state.turn = null;\n    } else {\n      state.turn = extra ? seat : 1 - seat;\n    }\n    return state;\n  },\n\n  status: function (state) {\n    if (!state.over) return { outcome: \"ongoing\", turn: state.turn };\n    var a = state.pits[6], b = state.pits[13];\n    if (a === b) return { outcome: \"draw\", turn: null };\n    return { outcome: { win: a > b ? 0 : 1 }, turn: null };\n  },\n\n  autoplay: function (state, seat) {\n    if (state.over || state.turn !== seat) return [];\n    var moves = [];\n    for (var p = 0; p < 6; p++) {\n      if (state.pits[seat * 7 + p] > 0) moves.push({ pit: p });\n    }\n    return moves;\n  }\n};\n","manifest":{"category":"board","coop":false,"guide":[{"en":"Finish with more stones in your store than your friend.","hy":"Խաղի վերջում քո գանձարանում ավելի շատ քար ունեցիր, քան ընկերդ։","kind":"goal"},{"en":"Six pits with four stones each on your side, the same on your friend's side, and a big store at each end. Your store is the one next to your pits, lit in your colour.","hy":"Քո կողմում վեց փոսիկ՝ յուրաքանչյուրում չորս քար, նույնը ընկերոջդ կողմում, և մեծ գանձարան յուրաքանչյուր ծայրում։ Քո գանձարանը քո փոսիկների կողքինն է՝ քո գույնով։","kind":"see"},{"en":"Tap one of your pits. Its stones are dropped one by one into the next pits, into your store, then on into your friend's pits. Your friend's store is skipped.","hy":"Սեղմիր քո փոսիկներից մեկը։ Քարերը մեկ առ մեկ ընկնում են հաջորդ փոսիկները, քո գանձարանը, ապա ընկերոջդ փոսիկները։ Ընկերոջդ գանձարանը բաց է թողնվում։","kind":"turn"},{"en":"Last stone in your store? Move again. Last stone in an empty pit on your side? It and all the stones in the pit opposite go into your store.","hy":"Վերջին քարն ընկավ քո գանձարանը՞։ Խաղա նորից։ Քո կողմի դատարկ փոսիկո՞ւմ։ Այն և դիմացի փոսիկի բոլոր քարերը գնում են քո գանձարանը։","kind":"turn"},{"en":"When either side is empty, the other player sweeps their remaining stones into their store. Most stones wins; 24 each is a draw.","hy":"Երբ որևէ կողմը դատարկվում է, մյուս խաղացողն իր մնացած քարերը տանում է իր գանձարանը։ Ով շատ քար ունի՝ հաղթում է, 24-24-ը ոչ-ոքի է։","kind":"win"},{"en":"Count before you tap: a pit with exactly the right number of stones to end in your store gives you a free extra move.","hy":"Սեղմելուց առաջ հաշվիր. փոսիկը, որի քարերը ճիշտ քո գանձարանում են ավարտվում, քեզ լրացուցիչ քայլ է տալիս։","kind":"tip"}],"icon":"🪨","id":"mancala","minBuild":6,"players":{"max":2,"min":2},"rules":{"en":"Scoop up all the stones in one of your pits and drop them one by one into the next pits, counter-clockwise, including your own store but skipping your friend's. Land in your store to move again; land in an empty pit on your side to capture the stones opposite. When one side runs out, the other player keeps what is left. Most stones wins.","hy":"Վերցրու քո փոսիկներից մեկի բոլոր քարերը և մեկ-մեկ գցիր հաջորդ փոսիկների մեջ՝ ժամացույցի սլաքին հակառակ, ներառյալ քո գանձարանը, բայց բաց թողնելով ընկերոջդ գանձարանը։ Վերջին քարը գանձարանում՝ նորից քո հերթն է, քո կողմի դատարկ փոսիկում՝ վերցնում ես դիմացի քարերը։ Երբ մի կողմը դատարկվում է, մյուսը պահում է մնացածը։ Ով շատ քար ունի՝ հաղթում է։","ru":"Возьми все камни из одной своей лунки и раскладывай их по одному против часовой стрелки, включая свой амбар, но пропуская амбар друга. Последний камень в амбаре — ходи снова; в пустой лунке на своей стороне — забери камни напротив. Когда одна сторона опустела, второй игрок оставляет себе остаток. Больше камней — победа."},"solo":true,"theme":["#8B5A2B","#2A7F62","#E9B949","#F6EBD9","#2A1D10"],"title":{"ar":"منقلة","de":"Mancala","en":"Mancala","es":"Mancala","fr":"Mancala","hy":"Մանկալա","ru":"Манкала"},"version":1}}