{"format":1,"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no\">\n<title>Ultimate Tic-Tac-Toe</title>\n<style>\n  :root {\n    --primary: #2F55C9; --secondary: #C2412E; --accent: #F2B134;\n    --page: #F3F5FA; --text: #0F1626;\n    --line: rgba(15,22,38,.14); --cell: rgba(15,22,38,.05); --board: rgba(255,255,255,.7);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root { --page: #0F1626; --text: #F3F5FA; --line: rgba(255,255,255,.16); --cell: rgba(255,255,255,.06); --board: rgba(255,255,255,.05); }\n  }\n  :root.dark { --line: rgba(255,255,255,.16); --cell: rgba(255,255,255,.06); --board: rgba(255,255,255,.05); }\n  :root.light { --line: rgba(15,22,38,.14); --cell: rgba(15,22,38,.05); --board: rgba(255,255,255,.7); }\n  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n  html, body { height: 100%; overflow: hidden; }\n  body {\n    background: var(--page); color: var(--text);\n    font-family: -apple-system, \"SF Pro Rounded\", system-ui, sans-serif;\n    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;\n    touch-action: manipulation;\n  }\n  #app {\n    position: fixed; inset: 0;\n    padding: calc(env(safe-area-inset-top) + 8px) 8px calc(env(safe-area-inset-bottom) + 8px);\n    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;\n  }\n  .scores { display: flex; justify-content: space-between; align-items: center; width: min(100%, 420px); padding: 0 6px; }\n  .seat { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 16px; max-width: 48%; }\n  .seat .mark { width: 30px; height: 30px; flex: 0 0 auto; }\n  .seat .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .seat .n { font-size: 20px; font-variant-numeric: tabular-nums; opacity: .8; }\n  .seat.right { flex-direction: row-reverse; }\n  .seat .name { text-decoration: underline transparent; text-decoration-thickness: 3px; text-underline-offset: 4px; transition: text-decoration-color .2s; }\n  .seat.active .name { text-decoration-color: currentColor; }\n\n  .board {\n    width: min(100vw - 16px, 100vh - 170px, 480px); aspect-ratio: 1;\n    display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 6px;\n    background: var(--line); padding: 6px; border-radius: 16px;\n  }\n  .small {\n    position: relative; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);\n    gap: 2px; background: var(--line); border-radius: 10px; overflow: hidden; padding: 2px;\n    transition: box-shadow .2s, opacity .2s;\n  }\n  .small.forced { box-shadow: 0 0 0 3px var(--accent); }\n  .small.dim { opacity: .5; }\n  .cell { position: relative; background: var(--board); display: flex; align-items: center; justify-content: center; cursor: default; }\n  .small .cell:nth-child(1) { border-top-left-radius: 8px; }\n  .small .cell:nth-child(3) { border-top-right-radius: 8px; }\n  .small .cell:nth-child(7) { border-bottom-left-radius: 8px; }\n  .small .cell:nth-child(9) { border-bottom-right-radius: 8px; }\n  .cell.legal { cursor: pointer; }\n  .cell.legal::after { content: \"\"; width: 22%; height: 22%; border-radius: 50%; background: var(--accent); opacity: .75; }\n  .cell.legal:active { background: var(--cell); }\n  .cell svg { width: 74%; height: 74%; display: block; }\n  .cell.last svg { animation: pop .3s ease-out both; }\n  .cell.inLine { background: var(--cell); }\n  .x { stroke: var(--primary); } .o { stroke: var(--secondary); }\n  svg { fill: none; stroke-width: 14; stroke-linecap: round; }\n  .overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--page); opacity: .92; pointer-events: none; }\n  .overlay svg { width: 70%; height: 70%; stroke-width: 10; }\n  .overlay.full { opacity: .55; font-size: 22px; font-weight: 800; }\n  .small.bigLine { box-shadow: 0 0 0 4px var(--accent); }\n  @keyframes pop { from { transform: scale(.2); } 70% { transform: scale(1.15); } to { transform: scale(1); } }\n  .status { font-size: 15px; font-weight: 600; opacity: .85; text-align: center; min-height: 20px; }\n  .status.mine { opacity: 1; }\n  .hint { font-size: 13px; opacity: .6; text-align: center; min-height: 16px; }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"scores\">\n    <div class=\"seat left\" id=\"seat0\"><span class=\"mark\"></span><span class=\"name\"></span><span class=\"n\">0</span></div>\n    <div class=\"seat right\" id=\"seat1\"><span class=\"mark\"></span><span class=\"name\"></span><span class=\"n\">0</span></div>\n  </div>\n  <div class=\"board\" id=\"board\"></div>\n  <div class=\"status\" id=\"status\"></div>\n  <div class=\"hint\" id=\"hint\"></div>\n</div>\n<script>\n(function () {\n  var T = {\n    en: { yourTurn: \"Your turn\", turnOf: \"{name}'s turn\", over: \"Game over\", forced: \"Play in the glowing board\", any: \"Play in any open board\", waiting: \"Sending…\", boards: \"boards\" },\n    hy: { yourTurn: \"Քո հերթն է\", turnOf: \"{name}-ի հերթն է\", over: \"Խաղն ավարտվեց\", forced: \"Խաղա լուսավոր դաշտում\", any: \"Խաղա ցանկացած ազատ դաշտում\", waiting: \"Ուղարկվում է…\", boards: \"դաշտ\" },\n    ru: { yourTurn: \"Твой ход\", turnOf: \"Ход {name}\", over: \"Игра окончена\", forced: \"Ходи в подсвеченном поле\", any: \"Ходи в любом открытом поле\", waiting: \"Отправка…\", boards: \"поля\" },\n    es: { yourTurn: \"Tu turno\", turnOf: \"Turno de {name}\", over: \"Fin de la partida\", forced: \"Juega en el tablero iluminado\", any: \"Juega en cualquier tablero abierto\", waiting: \"Enviando…\", boards: \"tableros\" },\n    de: { yourTurn: \"Du bist dran\", turnOf: \"{name} ist dran\", over: \"Spiel vorbei\", forced: \"Spiele im leuchtenden Feld\", any: \"Spiele in einem offenen Feld\", waiting: \"Senden…\", boards: \"Felder\" },\n    fr: { yourTurn: \"À toi\", turnOf: \"Au tour de {name}\", over: \"Partie terminée\", forced: \"Joue dans la grille éclairée\", any: \"Joue dans n'importe quelle grille ouverte\", waiting: \"Envoi…\", boards: \"grilles\" },\n    ar: { yourTurn: \"دورك\", turnOf: \"دور {name}\", over: \"انتهت اللعبة\", forced: \"العب في اللوحة المضيئة\", any: \"العب في أي لوحة مفتوحة\", waiting: \"جارٍ الإرسال…\", boards: \"لوحات\" }\n  };\n  function t(lang, key, name) {\n    var d = T[lang] || T.en;\n    return (d[key] || T.en[key] || key).replace(\"{name}\", name || \"\");\n  }\n  var X = '<svg viewBox=\"0 0 100 100\" class=\"x\"><path d=\"M22 22 L78 78 M78 22 L22 78\"/></svg>';\n  var O = '<svg viewBox=\"0 0 100 100\" class=\"o\"><circle cx=\"50\" cy=\"50\" r=\"30\"/></svg>';\n\n  var el = function (id) { return document.getElementById(id); };\n  var cellEls = [], smallEls = [];\n  var current = null, pending = false, pendingTimer = null;\n\n  function build() {\n    var board = el(\"board\");\n    board.innerHTML = \"\";\n    cellEls = []; smallEls = [];\n    for (var b = 0; b < 9; b++) {\n      var s = document.createElement(\"div\");\n      s.className = \"small\";\n      for (var c = 0; c < 9; c++) {\n        var cell = document.createElement(\"div\");\n        cell.className = \"cell\";\n        cell.setAttribute(\"data-board\", b);\n        cell.setAttribute(\"data-cell\", c);\n        cell.addEventListener(\"click\", onTap);\n        s.appendChild(cell);\n        cellEls.push(cell);\n      }\n      board.appendChild(s);\n      smallEls.push(s);\n    }\n    el(\"seat0\").querySelector(\".mark\").innerHTML = X;\n    el(\"seat1\").querySelector(\".mark\").innerHTML = O;\n  }\n\n  function applyTheme(th) {\n    var root = document.documentElement;\n    if (th.primary) root.style.setProperty(\"--primary\", th.primary);\n    if (th.secondary) root.style.setProperty(\"--secondary\", th.secondary);\n    if (th.accent) root.style.setProperty(\"--accent\", th.accent);\n    if (th.page) root.style.setProperty(\"--page\", th.page);\n    if (th.text) root.style.setProperty(\"--text\", th.text);\n    if (th.page) {\n      var hex = th.page.replace(\"#\", \"\");\n      var r = parseInt(hex.substr(0, 2), 16), g = parseInt(hex.substr(2, 2), 16), bl = parseInt(hex.substr(4, 2), 16);\n      var dark = (r * 299 + g * 587 + bl * 114) / 1000 < 128;\n      root.classList.toggle(\"dark\", dark);\n      root.classList.toggle(\"light\", !dark);\n    }\n  }\n\n  function render(state, ctx) {\n    if (!cellEls.length) build();\n    applyTheme(ctx.theme || {});\n    var seat = ctx.seat;\n    var legal = {};\n    if (ctx.myTurn && !ctx.over && typeof game !== \"undefined\") {\n      var moves = game.autoplay(state, seat);\n      for (var m = 0; m < moves.length; m++) legal[moves[m].board * 9 + moves[m].cell] = true;\n    }\n    var bigLine = {};\n    if (state.bigLine) for (var i = 0; i < 3; i++) bigLine[state.bigLine[i]] = true;\n\n    for (var b = 0; b < 9; b++) {\n      var s = smallEls[b];\n      var w = state.won[b];\n      var line = state.lines && state.lines[b] ? state.lines[b] : null;\n      var inLine = {};\n      if (line) for (var k = 0; k < 3; k++) inLine[line[k]] = true;\n      for (var c = 0; c < 9; c++) {\n        var idx = b * 9 + c, v = state.cells[idx], cell = cellEls[idx];\n        var html = v === 1 ? X : v === 2 ? O : \"\";\n        if (cell.getAttribute(\"data-v\") !== String(v)) {\n          cell.innerHTML = html;\n          cell.setAttribute(\"data-v\", v);\n        }\n        var isLast = state.last && state.last.board === b && state.last.cell === c;\n        cell.classList.toggle(\"last\", !!isLast);\n        cell.classList.toggle(\"legal\", !!legal[idx] && !pending);\n        cell.classList.toggle(\"inLine\", !!inLine[c]);\n      }\n      var old = s.querySelector(\".overlay\");\n      if (old) old.remove();\n      if (w === 1 || w === 2) {\n        var ov = document.createElement(\"div\");\n        ov.className = \"overlay\";\n        ov.innerHTML = w === 1 ? X : O;\n        s.appendChild(ov);\n      } else if (w === 3) {\n        var ov2 = document.createElement(\"div\");\n        ov2.className = \"overlay full\";\n        ov2.textContent = \"–\";\n        s.appendChild(ov2);\n      }\n      var forced = !ctx.over && ctx.myTurn && w === 0 && (state.next === b || (state.next === -1));\n      s.classList.toggle(\"forced\", !ctx.over && ctx.myTurn && w === 0 && state.next === b);\n      s.classList.toggle(\"dim\", !ctx.over && (!ctx.myTurn || (state.next !== -1 && state.next !== b) || (w !== 0 && !bigLine[b])));\n      s.classList.toggle(\"bigLine\", !!bigLine[b]);\n      void forced;\n    }\n\n    var counts = [0, 0];\n    for (var q = 0; q < 9; q++) if (state.won[q] === 1 || state.won[q] === 2) counts[state.won[q] - 1]++;\n    var th = ctx.theme || {};\n    var colors = [th.primary || \"#2F55C9\", th.secondary || \"#C2412E\"];\n    for (var sIdx = 0; sIdx < 2; sIdx++) {\n      var node = el(\"seat\" + sIdx);\n      node.querySelector(\".name\").textContent = ctx.names[sIdx] || \"\";\n      node.querySelector(\".n\").textContent = counts[sIdx];\n      node.style.color = colors[sIdx];\n      node.classList.toggle(\"active\", !ctx.over && state.turn === sIdx);\n    }\n\n    var status = el(\"status\"), hint = el(\"hint\");\n    status.classList.toggle(\"mine\", !!ctx.myTurn && !ctx.over);\n    if (ctx.over) {\n      status.textContent = t(ctx.lang, \"over\");\n      hint.textContent = \"\";\n    } else if (ctx.myTurn) {\n      status.textContent = t(ctx.lang, \"yourTurn\");\n      hint.textContent = pending ? t(ctx.lang, \"waiting\") : t(ctx.lang, state.next === -1 ? \"any\" : \"forced\");\n    } else {\n      status.textContent = t(ctx.lang, \"turnOf\", ctx.names[state.turn] || \"\");\n      hint.textContent = \"\";\n    }\n  }\n\n  function onTap(e) {\n    if (!current || pending) return;\n    var cell = e.currentTarget;\n    if (!cell.classList.contains(\"legal\")) return;\n    var move = { board: parseInt(cell.getAttribute(\"data-board\"), 10), cell: parseInt(cell.getAttribute(\"data-cell\"), 10) };\n    pending = true;\n    clearTimeout(pendingTimer);\n    pendingTimer = setTimeout(function () { pending = false; if (current) render(current.state, current.ctx); }, 1500);\n    if (AirPlayne.haptic) AirPlayne.haptic(\"tap\");\n    AirPlayne.send(move);\n    render(current.state, current.ctx);\n  }\n\n  AirPlayne.onState(function (state, ctx) {\n    pending = false;\n    clearTimeout(pendingTimer);\n    var wasOver = !!(current && current.ctx.over);\n    current = { state: state, ctx: ctx };\n    render(state, ctx);\n    if (ctx.over && !wasOver && AirPlayne.haptic) AirPlayne.haptic(ctx.outcome && ctx.outcome.win === ctx.seat ? \"success\" : \"tap\");\n  });\n})();\n</script>\n</body>\n</html>\n","logic":"// Ultimate Tic-Tac-Toe rules for AirPlayne. Pure reducer: no DOM, no clock, no randomness.\n//\n// cells: 81 ints, cells[board * 9 + cell]: 0 empty, 1 = X (seat 0), 2 = O (seat 1).\n// won: 9 ints per small board: 0 open, 1 = X, 2 = O, 3 = full with no line (nobody's).\n// next: the board the current player must play in, or -1 for any open board.\n// Move: {\"board\": 0…8, \"cell\": 0…8}. Boards and cells are numbered left to right, top to bottom.\n\nvar LINES = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];\n\nfunction lineOf(get, mark) {\n  for (var i = 0; i < LINES.length; i++) {\n    var l = LINES[i];\n    if (get(l[0]) === mark && get(l[1]) === mark && get(l[2]) === mark) return l;\n  }\n  return null;\n}\n\nconst game = {\n  init: function (opts) {\n    var cells = [];\n    for (var i = 0; i < 81; i++) cells.push(0);\n    var starter = opts && typeof opts.starter === \"number\" ? opts.starter : 0;\n    return {\n      cells: cells,\n      won: [0, 0, 0, 0, 0, 0, 0, 0, 0],\n      next: -1,\n      turn: starter === 1 ? 1 : 0,\n      over: false,\n      result: null,       // null | 0 | 1 | \"draw\"\n      lines: {},          // board -> [c1, c2, c3] winning cells, for the UI\n      bigLine: null,      // [b1, b2, b3] when the game is won\n      moves: 0,\n      last: null          // {board, cell, seat}\n    };\n  },\n\n  apply: function (state, move, seat) {\n    if (state.over) throw new Error(\"Game over\");\n    if (seat !== state.turn) throw new Error(\"Not your turn\");\n    if (!move || typeof move.board !== \"number\" || typeof move.cell !== \"number\" ||\n        move.board < 0 || move.board > 8 || move.cell < 0 || move.cell > 8 ||\n        move.board % 1 !== 0 || move.cell % 1 !== 0) {\n      throw new Error(\"Invalid move\");\n    }\n    var b = move.board, c = move.cell;\n    if (state.won[b] !== 0) throw new Error(\"That board is finished\");\n    if (state.next !== -1 && state.next !== b) throw new Error(\"Play in the highlighted board\");\n    if (state.cells[b * 9 + c] !== 0) throw new Error(\"That cell is taken\");\n\n    var mark = seat + 1;\n    state.cells[b * 9 + c] = mark;\n    state.last = { board: b, cell: c, seat: seat };\n    state.moves += 1;\n\n    var cells = state.cells;\n    var line = lineOf(function (i) { return cells[b * 9 + i]; }, mark);\n    if (line) {\n      state.won[b] = mark;\n      state.lines[b] = line;\n    } else {\n      var full = true;\n      for (var i = 0; i < 9; i++) if (cells[b * 9 + i] === 0) { full = false; break; }\n      if (full) state.won[b] = 3;\n    }\n\n    var won = state.won;\n    var big = lineOf(function (i) { return won[i]; }, mark);\n    if (big) {\n      state.over = true;\n      state.result = seat;\n      state.bigLine = big;\n      state.turn = null;\n      state.next = -1;\n      return state;\n    }\n    var anyOpen = false;\n    for (var k = 0; k < 9; k++) if (won[k] === 0) { anyOpen = true; break; }\n    if (!anyOpen) {\n      state.over = true;\n      state.result = \"draw\";\n      state.turn = null;\n      state.next = -1;\n      return state;\n    }\n    state.next = won[c] === 0 ? c : -1;\n    state.turn = 1 - seat;\n    return state;\n  },\n\n  status: function (state) {\n    if (!state.over) return { outcome: \"ongoing\", turn: state.turn };\n    if (state.result === \"draw\") return { outcome: \"draw\", turn: null };\n    return { outcome: { win: state.result }, turn: null };\n  },\n\n  autoplay: function (state, seat) {\n    if (state.over || state.turn !== seat) return [];\n    var moves = [];\n    for (var b = 0; b < 9; b++) {\n      if (state.won[b] !== 0) continue;\n      if (state.next !== -1 && state.next !== b) continue;\n      for (var c = 0; c < 9; c++) {\n        if (state.cells[b * 9 + c] === 0) moves.push({ board: b, cell: c });\n      }\n    }\n    return moves;\n  }\n};\n","manifest":{"category":"board","coop":false,"guide":[{"en":"Win three small boards in a row: across, down or diagonally.","hy":"Շահիր երեք փոքր դաշտ անընդմեջ՝ հորիզոնական, ուղղահայաց կամ անկյունագծով։","kind":"goal"},{"en":"A 3×3 grid of small tic-tac-toe boards. You are ✕ if you started, otherwise ◯. The board you must play in glows; small boards already won show a big ✕ or ◯.","hy":"3×3 ցանց՝ փոքր խաչ-զրո դաշտերով։ Սկսողը ✕ է, մյուսը՝ ◯։ Դաշտը, որտեղ պետք է խաղաս, լուսավորված է, իսկ շահված դաշտերը մեծ ✕ կամ ◯ են ցույց տալիս։","kind":"see"},{"en":"Tap an empty cell in the glowing board. Its position sends your friend to the matching small board: play top-left, and they must play in the top-left board.","hy":"Սեղմիր լուսավոր դաշտի ազատ վանդակը։ Դրա դիրքն ընկերոջդ ուղարկում է համապատասխան դաշտ. խաղա վերևի ձախ վանդակում, և նա պետք է խաղա վերևի ձախ դաշտում։","kind":"turn"},{"en":"Sent to a board that is already won or full? Then you may play in any open cell of any unfinished board.","hy":"Քեզ ուղարկեցին արդեն շահված կամ լցված դաշտ։ Այդ դեպքում խաղա ցանկացած անավարտ դաշտի ցանկացած ազատ վանդակում։","kind":"turn"},{"en":"Three in a row wins a small board. Three small boards in a row win the game. If all nine boards are finished with no line, it's a draw.","hy":"Երեքն անընդմեջ՝ փոքր դաշտը քոնն է։ Երեք դաշտ անընդմեջ՝ հաղթանակ։ Եթե բոլոր ինը դաշտներն ավարտվել են առանց շարքի՝ ոչ-ոքի է։","kind":"win"},{"en":"Think about where you are sending your friend, not only about the cell you take. Sending them to a finished board gives them a free move anywhere.","hy":"Մտածիր, թե ուր ես ուղարկում ընկերոջդ, ոչ միայն թե որ վանդակն ես վերցնում։ Ավարտված դաշտ ուղարկելը նրան ազատ քայլ է տալիս։","kind":"tip"}],"icon":"#️⃣","id":"ultimate-ttt","minBuild":6,"players":{"max":2,"min":2},"rules":{"en":"Nine small tic-tac-toe boards make one big board. The cell you play sends your friend to the matching small board; if that board is already won or full, they may play anywhere open. Three in a row wins a small board, and three small boards in a row win the game.","hy":"Ինը փոքր խաչ-զրո՝ մեկ մեծ դաշտում։ Վանդակը, որտեղ խաղում ես, ընկերոջդ ուղարկում է համապատասխան փոքր դաշտ, իսկ եթե այն արդեն շահված է կամ լցված, նա խաղում է ցանկացած ազատ տեղ։ Երեքը անընդմեջ՝ փոքր դաշտն է քոնը, երեք փոքր դաշտ անընդմեջ՝ հաղթանակ։","ru":"Девять маленьких полей крестиков-ноликов на одном большом. Клетка, в которую ты ходишь, отправляет друга в такое же маленькое поле; если оно уже выиграно или заполнено, он ходит куда угодно. Три в ряд — маленькое поле твоё, три поля в ряд — победа."},"solo":true,"theme":["#2F55C9","#C2412E","#F2B134","#F3F5FA","#0F1626"],"title":{"ar":"إكس أو الكبرى","de":"Ultimatives Tic-Tac-Toe","en":"Ultimate Tic-Tac-Toe","es":"Tres en raya definitivo","fr":"Morpion ultime","hy":"Մեծ խաչ-զրո","ru":"Большие крестики-нолики"},"version":1}}